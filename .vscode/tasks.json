{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Vite Dev Server",
      "type": "shell",
      "command": "\"C:\\Program Files\\nodejs\\npm.cmd\" run dev",
      "windows": {
        "options": {
          "shell": {
            "executable": "cmd.exe",
            "args": ["/d", "/s", "/c"]
          }
        }
      },
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PATH": "C:\\Program Files\\nodejs;${env:PATH}"
        }
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "vite",
        "pattern": {
          "regexp": "^\\s*$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "VITE",
          "endsPattern": "Local:.*5173"
        }
      },
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated",
        "clear": true
      },
      "runOptions": {
        "instanceLimit": 1
      }
    },
    {
      "label": "Vite Build",
      "type": "shell",
      "command": "\"C:\\Program Files\\nodejs\\npm.cmd\" run build",
      "windows": {
        "options": {
          "shell": {
            "executable": "cmd.exe",
            "args": ["/d", "/s", "/c"]
          }
        }
      },
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PATH": "C:\\Program Files\\nodejs;${env:PATH}"
        }
      },
      "group": "build",
      "problemMatcher": []
    }
  ]
}